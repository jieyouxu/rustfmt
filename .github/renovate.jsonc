// Config docs: <https://docs.renovatebot.com/configuration-options/>
// Shared rust-lang presets: <https://github.com/rust-lang/renovate>
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rust-lang/renovate:actions",
    "github>rust-lang/renovate:lockfile"
  ],
  "enabledManagers": [
    "cargo",
    "github-actions"
  ],
  "packageRules": [
    {
      // Note that dep bumps can cause subtle formatting changes that can be
      // undetected by existing test suites.
      "matchManagers": ["cargo"],
      "extends": ["schedule:weekly"],
      // Do not pick up very new artifacts to reduce likelihood of fresh supply
      // chain compromises. NB: this only affects PRs for breaking bumps; see
      // `registry.global-min-publish-age` in `.cargo/config.toml` for lockfile
      // updates.
      "minimumReleaseAge": "7 days"
    }
  ]
}
